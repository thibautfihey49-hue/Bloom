<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/gray_200">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="10dp"
        android:background="@color/white">
        
        <TextView
            android:id="@+id/tvStatut"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔄 Initialisation..."
            android:textSize="13sp"
            android:textColor="@color/purple_500"/>

        <TextView
            android:id="@+id/tvMoi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔵 MOI: —"
            android:textSize="11sp"
            android:textColor="@color/blue_500"/>

        <TextView
            android:id="@+id/tvLui"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔴 LUI: —"
            android:textSize="11sp"
            android:textColor="@color/red_500"/>

        <TextView
            android:id="@+id/tvDistance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📡 Dernier envoi: —"
            android:textSize="10sp"
            android:textColor="@color/orange_500"/>
    </LinearLayout>

    <org.osmdroid.views.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="10dp"
        android:background="@color/white">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📱 Mon numéro (+336...)"
            android:textSize="11sp"
            android:textColor="@color/purple_500"/>
        <EditText
            android:id="@+id/etMonNumero"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="+336123456789"
            android:inputType="phone"
            android:textSize="13sp"
            android:padding="6dp"
            android:layout_marginBottom="6dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📱 Numéro de l'autre"
            android:textSize="11sp"
            android:textColor="@color/red_500"/>
        <EditText
            android:id="@+id/etAutreNumero"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="+33698765432"
            android:inputType="phone"
            android:textSize="13sp"
            android:padding="6dp"/>
    </LinearLayout>

    <!-- 🎮 CONTRÔLE À DISTANCE -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp"
        android:background="#F0F4FF">
        
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🎮 CONTRÔLE À DISTANCE"
            android:textSize="12sp"
            android:textColor="@color/purple_500"
            android:textStyle="bold"
            android:gravity="center"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="6dp">

            <Button
                android:id="@+id/btnDemander"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="📥 Demander"
                android:textSize="10sp"
                android:backgroundTint="@color/red_500"
                android:layout_marginEnd="3dp"/>

            <Button
                android:id="@+id/btnRepondre"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="📤 Répondre"
                android:textSize="10sp"
                android:backgroundTint="@color/green_500"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="3dp"/>

            <Button
                android:id="@+id/btnSuivre"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="🔄 Réponse auto"
                android:textSize="10sp"
                android:backgroundTint="@color/orange_500"
                android:layout_marginStart="3dp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="6dp">

            <Button
                android:id="@+id/btnDemarrerLui"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="▶️ Lui démarrer"
                android:textSize="10sp"
                android:backgroundTint="@color/green_500"
                android:layout_marginEnd="3dp"/>

            <Button
                android:id="@+id/btnArreterLui"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="⏹️ Lui arrêter"
                android:textSize="10sp"
                android:backgroundTint="@color/red_500"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="3dp"/>

            <Button
                android:id="@+id/btnSuiviContinu"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="📡 Moi suivre"
                android:textSize="10sp"
                android:backgroundTint="@color/blue_500"
                android:layout_marginStart="3dp"/>
        </LinearLayout>

        <Button
            android:id="@+id/btnPermissions"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:text="🔑 Permissions"
            android:textSize="11sp"
            android:backgroundTint="@color/purple_500"
            android:layout_marginTop="6dp"/>
    </LinearLayout>

</LinearLayout>
