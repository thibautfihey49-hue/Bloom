<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F7FA"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp"
        android:background="#FFFFFF"
        android:elevation="2dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📱 Mon numéro"
            android:textSize="12sp"
            android:textColor="#6B7280"/>
        <EditText
            android:id="@+id/etMonNumero"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ex: +336123456789"
            android:inputType="phone"
            android:textSize="14sp"
            android:padding="8dp"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📱 Numéro de l'autre"
            android:textSize="12sp"
            android:textColor="#6B7280"/>
        <EditText
            android:id="@+id/etAutreNumero"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ex: +33698765432"
            android:inputType="phone"
            android:textSize="14sp"
            android:padding="8dp"/>
    </LinearLayout>

    <org.osmdroid.views.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#E5E7EB"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:background="#FFFFFF">

        <TextView
            android:id="@+id/tvMonStatut"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="📍 Moi: —"
            android:textSize="12sp"
            android:textColor="#374151"/>

        <TextView
            android:id="@+id/tvAutreStatut"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="📍 Autre: —"
            android:textSize="12sp"
            android:textColor="#374151"
            android:gravity="end"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp"
        android:background="#FFFFFF">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnStartLocal"
                android:layout_width="0dp"
                android:layout_height="55dp"
                android:layout_weight="1"
                android:text="▶️ START"
                android:textSize="14sp"
                android:backgroundTint="#10B981"
                android:layout_marginEnd="6dp"/>

            <Button
                android:id="@+id/btnStopLocal"
                android:layout_width="0dp"
                android:layout_height="55dp"
                android:layout_weight="1"
                android:text="⏹️ STOP"
                android:textSize="14sp"
                android:backgroundTint="#EF4444"
                android:layout_marginStart="6dp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp">

            <Button
                android:id="@+id/btnStartRemote"
                android:layout_width="0dp"
                android:layout_height="55dp"
                android:layout_weight="1"
                android:text="📲 DÉMARRER À DISTANCE"
                android:textSize="12sp"
                android:backgroundTint="#6366F1"
                android:layout_marginEnd="6dp"/>

            <Button
                android:id="@+id/btnStopRemote"
                android:layout_width="0dp"
                android:layout_height="55dp"
                android:layout_weight="1"
                android:text="📲 ARRÊTER À DISTANCE"
                android:textSize="12sp"
                android:backgroundTint="#F59E0B"
                android:layout_marginStart="6dp"/>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
