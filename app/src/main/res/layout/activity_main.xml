<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#121212"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🌸 BLOOM GPS — SMS de DONNÉES"
        android:textSize="22sp"
        android:textStyle="bold"
        android:gravity="center"
        android:textColor="#4CAF50"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:id="@+id/tvStatut"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="✅ Prêt"
        android:textSize="14sp"
        android:textColor="#FFFFFF"
        android:background="#1E1E1E"
        android:padding="12dp"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/tvVitesse"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="⚡ Vitesse : -- km/h"
        android:textSize="14sp"
        android:textColor="#FFC107"
        android:background="#1E1E1E"
        android:padding="12dp"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📱 Numéro de l'autre téléphone :"
        android:textSize="14sp"
        android:textColor="#AAAAAA"
        android:layout_marginBottom="4dp"/>

    <EditText
        android:id="@+id/etNumeroDest"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Ex: 0612345678"
        android:inputType="phone"
        android:textColor="#FFFFFF"
        android:background="#2A2A2A"
        android:padding="12dp"
        android:layout_marginBottom="16dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gap="8dp"
        android:layout_marginBottom="8dp">

        <Button
            android:id="@+id/btnStart"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="▶️ DÉMARRER MOI"
            android:background="#2E7D32"
            android:textColor="#FFFFFF"
            android:paddingVertical="12dp"/>

        <Button
            android:id="@+id/btnStop"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="⏹️ ARRÊTER MOI"
            android:background="#C62828"
            android:textColor="#FFFFFF"
            android:paddingVertical="12dp"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gap="8dp"
        android:layout_marginBottom="16dp">

        <Button
            android:id="@+id/btnStartDist"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="📡 DÉMARRER À DISTANCE"
            android:background="#1565C0"
            android:textColor="#FFFFFF"
            android:paddingVertical="12dp"/>

        <Button
            android:id="@+id/btnStopDist"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="📡 ARRÊTER À DISTANCE"
            android:background="#FF6F00"
            android:textColor="#FFFFFF"
            android:paddingVertical="12dp"/>
    </LinearLayout>

    <org.osmdroid.views.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"/>

</LinearLayout>
