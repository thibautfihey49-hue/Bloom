<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5"
    android:padding="12dp"
    tools:context=".MainActivity">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🌸 Bloom GPS"
        android:textSize="24sp"
        android:textStyle="bold"
        android:gravity="center"
        android:padding="16dp"
        android:textColor="#FF6B3B"/>

    <TextView
        android:id="@+id/tvStatut"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="✅ Prêt"
        android:textSize="14sp"
        android:gravity="center"
        android:padding="8dp"
        android:background="#E8F5E9"
        android:textColor="#2E7D32"/>

    <TextView
        android:id="@+id/tvVitesse"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="⚡ Vitesse : 0 km/h"
        android:textSize="16sp"
        android:textStyle="bold"
        android:gravity="center"
        android:padding="8dp"
        android:layout_marginTop="8dp"/>

    <EditText
        android:id="@+id/etNumeroDest"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="📱 Numéro de l'autre téléphone"
        android:inputType="phone"
        android:padding="12dp"
        android:layout_marginTop="8dp"
        android:background="#FFFFFF"
        android:textSize="14sp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="12dp"
        android:gap="8dp">

        <Button
            android:id="@+id/btnStart"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:text="▶️ MOI — Démarrer"
            android:background="#4CAF50"
            android:textColor="#FFFFFF"
            android:textSize="12sp"/>

        <Button
            android:id="@+id/btnStop"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:text="⏹️ MOI — Arrêter"
            android:background="#F44336"
            android:textColor="#FFFFFF"
            android:textSize="12sp"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp"
        android:gap="8dp">

        <Button
            android:id="@+id/btnStartDist"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:text="📤 À distance — Démarrer"
            android:background="#2196F3"
            android:textColor="#FFFFFF"
            android:textSize="12sp"/>

        <Button
            android:id="@+id/btnStopDist"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:text="📤 À distance — Arrêter"
            android:background="#FF9800"
            android:textColor="#FFFFFF"
            android:textSize="12sp"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp"
        android:gap="8dp">

        <Button
            android:id="@+id/btnPermissions"
            android:layout_width="0dp"
            android:layout_height="45dp"
            android:layout_weight="1"
            android:text="🔑 Autorisations"
            android:background="#9C27B0"
            android:textColor="#FFFFFF"
            android:textSize="11sp"/>

        <Button
            android:id="@+id/btnNotif"
            android:layout_width="0dp"
            android:layout_height="45dp"
            android:layout_weight="1"
            android:text="🔔 Notifications"
            android:background="#607D8B"
            android:textColor="#FFFFFF"
            android:textSize="11sp"/>
    </LinearLayout>

    <org.osmdroid.views.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="💡 Astuce : Compose *#2566# pour ouvrir l'app cachée"
        android:textSize="11sp"
        android:gravity="center"
        android:padding="8dp"
        android:textColor="#757575"/>

</LinearLayout>
