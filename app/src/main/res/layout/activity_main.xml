<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#F5F5F5">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🌸 Bloom GPS"
        android:textSize="24sp"
        android:textStyle="bold"
        android:gravity="center"
        android:padding="16dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🔒 SMS DE DONNÉES — ANDROID 14 COMPATIBLE"
        android:textSize="12sp"
        android:gravity="center"
        android:padding="4dp"
        android:background="#E8F5E9"
        android:textColor="#2E7D32"/>

    <TextView
        android:id="@+id/tvStatut"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="⏳ En attente de position..."
        android:textSize="14sp"
        android:padding="8dp"
        android:background="#E8F5E9"
        android:textColor="#2E7D32"
        android:layout_marginTop="8dp"/>

    <TextView
        android:id="@+id/tvVitesse"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🟦 Ma vitesse | 🟥 Vitesse autre : 0 km/h"
        android:textSize="14sp"
        android:padding="8dp"
        android:layout_marginTop="8dp"/>

    <org.osmdroid.views.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginVertical="16dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📱 Numéro de l'autre téléphone :"
        android:textSize="14sp"
        android:textStyle="bold"/>

    <EditText
        android:id="@+id/etNumeroDest"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="07 00 00 00 00"
        android:inputType="phone"
        android:layout_marginVertical="8dp"
        android:backgroundTint="#2196F3"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <Button
            android:id="@+id/btnStart"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="▶️ MOI — Démarrer"
            android:background="#4CAF50"
            android:textColor="#FFFFFF"/>

        <Button
            android:id="@+id/btnStop"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:text="⏹️ MOI — Arrêter"
            android:background="#F44336"
            android:textColor="#FFFFFF"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <Button
            android:id="@+id/btnStartDist"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="▶️ À DISTANCE — Démarrer"
            android:background="#2196F3"
            android:textColor="#FFFFFF"/>

        <Button
            android:id="@+id/btnStopDist"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:text="⏹️ À DISTANCE — Arrêter"
            android:background="#FF9800"
            android:textColor="#FFFFFF"/>
    </LinearLayout>

</LinearLayout>
