<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#F5F5F5"
    tools:context=".MainActivity">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🌸 Bloom GPS"
        android:textSize="28sp"
        android:textStyle="bold"
        android:gravity="center"
        android:padding="16dp"
        android:textColor="#E91E63"/>

    <TextView
        android:id="@+id/tvStatut"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🔍 Vérification des permissions..."
        android:padding="12dp"
        android:background="#E8F5E9"
        android:textColor="#2E7D32"
        android:layout_marginBottom="16dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/tvVitesseMoi"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Ma vitesse : 0 km/h"
            android:padding="8dp"
            android:background="#BBDEFB"
            android:textColor="#1565C1"
            android:layout_marginEnd="4dp"/>

        <TextView
            android:id="@+id/tvVitesseAutre"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Vitesse autre : 0 km/h"
            android:padding="8dp"
            android:background="#FFCDD2"
            android:textColor="#C62828"
            android:layout_marginStart="4dp"/>
    </LinearLayout>

    <org.osmdroid.views.MapView
        android:id="@+id/map"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginBottom="16dp"/>

    <EditText
        android:id="@+id/etNumeroAutre"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="📞 Numéro de l'autre téléphone"
        android:inputType="phone"
        android:padding="12dp"
        android:layout_marginBottom="16dp"
        android:background="#FFFFFF"
        android:textSize="16sp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <Button
            android:id="@+id/btnDemarrerMoi"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="▶️ MOI — Démarrer"
            android:background="#4CAF50"
            android:textColor="#FFFFFF"
            android:padding="12dp"
            android:layout_marginEnd="4dp"/>

        <Button
            android:id="@+id/btnArreterMoi"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="⏹️ MOI — Arrêter"
            android:background="#F44336"
            android:textColor="#FFFFFF"
            android:padding="12dp"
            android:layout_marginStart="4dp"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnDemarrerAutre"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="📡 À DISTANCE — Démarrer"
            android:background="#2196F3"
            android:textColor="#FFFFFF"
            android:padding="12dp"
            android:layout_marginEnd="4dp"/>

        <Button
            android:id="@+id/btnArreterAutre"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="📡 À DISTANCE — Arrêter"
            android:background="#FF9800"
            android:textColor="#FFFFFF"
            android:padding="12dp"
            android:layout_marginStart="4dp"/>
    </LinearLayout>

</LinearLayout>
