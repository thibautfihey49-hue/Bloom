<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Titre -->
        <TextView
            android:id="@+id/tvTitre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🌸 Bloom — Espace Parent"
            android:textSize="28sp"
            android:textColor="#6366F1"
            android:layout_marginBottom="32dp"
            android:gravity="center"/>

        <!-- Statut -->
        <TextView
            android:id="@+id/tvStatut"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="✅ Connecté — Surveillance active"
            android:textSize="16sp"
            android:textColor="#10B981"
            android:layout_marginBottom="24dp"
            android:gravity="center"/>

        <!-- Demande de temps -->
        <TextView
            android:id="@+id/tvDemandeTemps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⏳ &quot;Je peux avoir plus de temps ?&quot;"
            android:textSize="18sp"
            android:background="#FEF3C7"
            android:textColor="#92400E"
            android:padding="16dp"
            android:layout_marginBottom="24dp"
            android:visibility="gone"
            android:gravity="center"/>

        <!-- Bouton Verrouiller -->
        <Button
            android:id="@+id/btnVerrouiller"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔒 VERROUILLER L'APPAREIL"
            android:textSize="16sp"
            android:backgroundTint="#EF4444"
            android:textColor="#FFFFFF"
            android:paddingVertical="16dp"
            android:layout_marginBottom="16dp"/>

        <!-- Bouton Déverrouiller -->
        <Button
            android:id="@+id/btnDeverrouiller"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔓 DÉVERROUILLER L'APPAREIL"
            android:textSize="16sp"
            android:backgroundTint="#10B981"
            android:textColor="#FFFFFF"
            android:paddingVertical="16dp"
            android:layout_marginBottom="16dp"/>

        <!-- Bouton Position -->
        <Button
            android:id="@+id/btnPosition"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📍 OBTENIR LA POSITION"
            android:textSize="16sp"
            android:backgroundTint="#6366F1"
            android:textColor="#FFFFFF"
            android:paddingVertical="16dp"
            android:layout_marginBottom="24dp"/>

        <!-- Carte -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🗺️ Position de l'enfant"
            android:textSize="20sp"
            android:textColor="#374151"
            android:layout_marginBottom="12dp"/>

        <org.osmdroid.views.MapView
            android:id="@+id/mapView"
            android:layout_width="match_parent"
            android:layout_height="400dp"
            android:background="#E5E7EB"/>

    </LinearLayout>
</ScrollView>
