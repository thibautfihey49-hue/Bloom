<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#F5F7FA">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🌸 BLOOM — Contrôle Parental"
        android:textSize="24sp"
        android:textStyle="bold"
        android:gravity="center"
        android:padding="20dp"
        android:textColor="#2D3748"/>

    <!-- 📱 Numéro de l'enfant -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📱 Numéro de l'enfant :"
        android:textSize="14sp"
        android:textColor="#4A5568"
        android:layout_marginTop="8dp"/>

    <EditText
        android:id="@+id/edit_num_enfant"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="+33 6 12 34 56 78"
        android:inputType="phone"
        android:background="@drawable/edittext_bg"
        android:padding="12dp"
        android:layout_marginBottom="16dp"/>

    <!-- ⏳ Curseur Temps -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="⏳ Temps d'écran autorisé :"
        android:textSize="14sp"
        android:textColor="#4A5568"/>

    <TextView
        android:id="@+id/txt_temps"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="⏳ 2 heures"
        android:textSize="18sp"
        android:textStyle="bold"
        android:gravity="center"
        android:padding="8dp"
        android:textColor="#2B6CB0"/>

    <SeekBar
        android:id="@+id/seek_temps"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="24"
        android:progress="2"
        android:thumbTint="#2B6CB0"
        android:progressTint="#2B6CB0"
        android:layout_marginBottom="16dp"/>

    <!-- 📍 Boutons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gap="12dp">

        <Button
            android:id="@+id/btn_localiser"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:text="📍 LOCALISER"
            android:backgroundTint="#38A169"
            android:textSize="14sp"
            android:textStyle="bold"/>

        <Button
            android:id="@+id/btn_pause"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:text="⏹️ COUPER"
            android:backgroundTint="#E53E3E"
            android:textSize="14sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <!-- 📍 Position affichée -->
    <TextView
        android:id="@+id/txt_position"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📍 Aucune position"
        android:textSize="14sp"
        android:padding="12dp"
        android:gravity="center"
        android:layout_marginTop="16dp"
        android:background="#E2E8F0"
        android:textColor="#2D3748"/>

    <!-- 🗺️ Carte hors connexion -->
    <org.osmdroid.views.MapView
        android:id="@+id/map_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp"/>

</LinearLayout>
