<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0FDF4"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Titre -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🌸 Bloom — Mon Espace"
            android:textSize="28sp"
            android:textColor="#059669"
            android:layout_marginBottom="32dp"
            android:gravity="center"/>

        <!-- Statut -->
        <TextView
            android:id="@+id/tvStatut"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="✅ Connecté — Surveillance active"
            android:textSize="16sp"
            android:textColor="#10B981"
            android:layout_marginBottom="32dp"
            android:gravity="center"/>

        <!-- Demande de temps -->
        <TextView
            android:id="@+id/tvDemandeTemps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⏳ Demande envoyée : &quot;Je peux avoir plus de temps ?&quot;"
            android:textSize="18sp"
            android:background="#D1FAE5"
            android:textColor="#065F46"
            android:padding="16dp"
            android:layout_marginBottom="32dp"
            android:visibility="gone"
            android:gravity="center"/>

        <!-- Bouton Demander temps -->
        <Button
            android:id="@+id/btnDemanderTemps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⏳ DEMANDER PLUS DE TEMPS"
            android:textSize="16sp"
            android:backgroundTint="#10B981"
            android:textColor="#FFFFFF"
            android:paddingVertical="16dp"/>

    </LinearLayout>
</ScrollView>
